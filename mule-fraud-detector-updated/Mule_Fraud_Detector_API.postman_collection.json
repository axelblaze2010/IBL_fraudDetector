  "item": [
    {
      "name": "Spring Boot Fraud Service",
      "description": "Fraud detection APIs - Base URL: http://localhost:8080/api/fraud",
      "item": [
        {
          "name": "1. Check Mule Risk - Analyze Transaction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccountId\": \"ACC1001\",\n  \"toAccountId\": \"ACC2002\",\n  \"amount\": 50000,\n  \"transactionType\": \"UPI\",\n  \"deviceId\": \"device-abc-123\",\n  \"sessionId\": \"session-001\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/fraud/check-mule",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "fraud", "check-mule"]
            },
            "description": "Analyzes a transaction for mule fraud risk:\n- Saves transaction to MongoDB\n- Updates account/account_links graph\n- Computes rule-based fraud scores (velocity, graph-depth, behavior, device)\n- Calls ML service for anomaly scoring\n- Combines both scores (60% rule + 40% ML)\n- Creates fraud case if CRITICAL"
          },
          "response": [
            {
              "name": "Successful Response (HIGH Risk)",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json",
                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"fromAccountId\": \"ACC1001\",\n  \"toAccountId\": \"ACC2002\",\n  \"amount\": 50000,\n  \"transactionType\": \"UPI\",\n  \"deviceId\": \"device-abc-123\",\n  \"sessionId\": \"session-001\"\n}"
                },
                "url": {
                  "raw": "http://localhost:8080/api/fraud/check-mule",
                  "protocol": "http",
                  "host": ["localhost"],
                  "port": "8080",
                  "path": ["api", "fraud", "check-mule"]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"accountId\": \"ACC2002\",\n  \"riskScore\": 75,\n  \"riskLevel\": \"HIGH\",\n  \"action\": \"STEP_UP_AUTH\",\n  \"ruleScore\": 55,\n  \"mlScore\": 85,\n  \"referenceId\": null,\n  \"reasons\": [\n    \"High transaction velocity: more than 10 incoming transactions in last 1 hour\",\n    \"Fan-out pattern detected: account sent to 5+ accounts within 10 minutes\",\n    \"ML signal: account behaves like pass-through money pipe\"\n  ],\n  \"recommendation\": \"Require biometric or OTP step-up\"\n}"
            },
            {
              "name": "Critical Risk - Fraud Case Created",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json",
                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"fromAccountId\": \"ACC1001\",\n  \"toAccountId\": \"ACC2002\",\n  \"amount\": 50000,\n  \"transactionType\": \"UPI\",\n  \"deviceId\": \"device-abc-123\",\n  \"sessionId\": \"session-001\"\n}"
                },
                "url": {
                  "raw": "http://localhost:8080/api/fraud/check-mule",
                  "protocol": "http",
                  "host": ["localhost"],
                  "port": "8080",
                  "path": ["api", "fraud", "check-mule"]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"accountId\": \"ACC2002\",\n  \"riskScore\": 92,\n  \"riskLevel\": \"CRITICAL\",\n  \"action\": \"BLOCK\",\n  \"ruleScore\": 75,\n  \"mlScore\": 95,\n  \"referenceId\": \"FRAUD-20260507-ABCDEFGH\",\n  \"reasons\": [\n    \"Circular money flow detected within 5 hops\",\n    \"ML signal: account behaves like pass-through money pipe\",\n    \"ML signal: device pattern resembles mule cluster\"\n  ],\n  \"recommendation\": \"Block transaction and create fraud case\"\n}"
            }
          ]
        },
